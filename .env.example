APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Vigil brand ---------------------------------------------------------
# The name lives here and nowhere else. Change it and the product renames
# itself everywhere visible; there is a test that proves it.
BRAND_NAME=Vigil
BRAND_SHORT_NAME=VG
BRAND_TAGLINE="AI-Driven Edge"

BRAND_LEGAL_NAME="Vigil Analytics"
BRAND_SUPPORT_EMAIL=support@example.com
# CAN-SPAM requires a real postal address on commercial mail. Marketing
# email will not send without one.
BRAND_POSTAL_ADDRESS=

# --- Compliance ----------------------------------------------------------
VIGIL_MINIMUM_AGE=21

# --- Edge Lab -----------------------------------------------------------
# The engine. Vigil reads its numbers from here and nowhere else, and never
# recomputes one. Off until a token is set: every sync records a skip and
# the sync-health page says so, rather than showing an empty board as
# though it were a quiet night.
#
# The token is VIGIL_INTERNAL_TOKEN in Edge Lab's own environment.
EDGE_LAB_URL=https://parlayq.com/internal/v1
EDGE_LAB_TOKEN=
