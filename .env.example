APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# The clock the product is read on. Storage stays UTC; this is what a
# kickoff is shown on and which day the board files it under.
APP_DISPLAY_TIMEZONE=America/New_York

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Vigil brand ---------------------------------------------------------
# The name lives here and nowhere else. Change it and the product renames
# itself everywhere visible; there is a test that proves it.
BRAND_NAME=Vigil
BRAND_SHORT_NAME=VG
BRAND_TAGLINE="AI-Driven Edge"

BRAND_LEGAL_NAME="Vigil Analytics"
BRAND_SUPPORT_EMAIL=support@example.com
# CAN-SPAM requires a real postal address on commercial mail. Marketing
# email will not send without one.
BRAND_POSTAL_ADDRESS=

# --- Compliance ----------------------------------------------------------
VIGIL_MINIMUM_AGE=21

# --- The engine ---------------------------------------------------------
# Vigil reads its numbers from the engine and nowhere else, and never
# recomputes one. The engine is part of this application now, so there is
# no URL and no token: ENGINE_ENABLED=false is the only switch, and it
# exists so a deployment whose engine has no data yet says "not connected"
# rather than rendering a confident, empty board.
ENGINE_ENABLED=true

# --- The Vigil Read (Claude) --------------------------------------------
# The AI layer explains numbers and never produces them. It is handed a
# fact sheet built only from stored rows, is never asked who will win, and
# every figure it writes must already appear in that sheet - a Read that
# fails validation is regenerated once and then replaced by a templated
# explanation that cannot invent anything.
#
# Without a key the product still writes Reads, from the template.
ANTHROPIC_API_KEY=

VIGIL_AI_MODEL=claude-sonnet-5-5
VIGIL_AI_BULK_MODEL=claude-haiku-5-5
# Bump to regenerate every Read. Old ones stay on disk: what a customer
# was actually shown is part of the record.
VIGIL_AI_PROMPT_VERSION=1

# Required when the key is not itself scoped to a workspace: Anthropic
# rejects the request and names this header. Either an organisation-level
# key plus this id, or a workspace-scoped key and no id.
ANTHROPIC_WORKSPACE_ID=

# --------------------------------------------------------------------------
# Payments
# --------------------------------------------------------------------------
#
# `none` is the honest default: with no merchant account there is no
# processor, and a driver that pretended to take a card would be the worst
# bug in this product. Nothing is on sale until this is set.
#
# Switching between `nmi` and `stripe` is a change here and nowhere else,
# which §13 is tested against.
PAYMENT_DRIVER=none

# NMI. The first driver, because it is what high-risk merchant accounts
# tend to come with. Use https://sandbox.nmi.com/api while testing.
NMI_BASE_URL=https://secure.nmi.com/api
NMI_API_KEY=
NMI_WEBHOOK_SIGNING_KEY=

# Plan ids created once in the merchant portal. A subscription created
# against a blank one bills nobody anything, so the driver refuses rather
# than sending it.
NMI_PLAN_DAILY_MONTHLY=
NMI_PLAN_DAILY_YEARLY=
NMI_PLAN_PRO_MONTHLY=
NMI_PLAN_PRO_YEARLY=

# Stripe, behind a flag. Flagged off rather than merely unconfigured
# because Stripe's prohibited-business list names sports forecasting with
# a monetary or material prize, and this product sells forecasts. The
# driver exists so a change of processor is an afternoon, not a rewrite.
PAYMENT_STRIPE_ENABLED=false
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DAILY_MONTHLY=
STRIPE_PRICE_DAILY_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# --------------------------------------------------------------------------
# Alerts
# --------------------------------------------------------------------------
#
# Web push identity. Generate a pair with `php artisan vigil:vapid` and put
# them here — the private key is the only thing standing between this
# application and anybody else pushing notifications to its subscribers, so
# it must never be committed and never reaches the database.
#
# Changing these invalidates every existing push subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: URL push services use to reach whoever is sending.
# Defaults to mailto:BRAND_SUPPORT_EMAIL. A real address, because a blocked
# sender with no contact route stays blocked.
VAPID_SUBJECT=

# Ceilings, not targets. The failure mode is not a missed notification; it
# is eleven of them in an afternoon, which gets the app uninstalled and the
# sending domain blocked.
ALERTS_DAILY_EMAIL_CAP=10
ALERTS_DAILY_PUSH_CAP=20

# An alert older than this is dropped rather than delivered. A queue that
# was stuck overnight must not empty itself into somebody's phone in the
# morning, and a notification about a game that has started is worse than
# silence.
ALERTS_MAX_AGE_MINUTES=180

# The engine: odds, schedules, stats and the bankroll it sizes with.
# These used to live in a second deployment. One application now.
EDGE_SPORTS=nfl,nba,mlb,nhl,ncaaf,ncaab
ODDS_API_KEY=
ODDS_API_REGIONS=us,us2
ODDS_API_MONTHLY_QUOTA=25000000
CFBD_API_KEY=
CBD_API_KEY=
EDGE_STARTING_BANKROLL_CENTS=500000
EDGE_UNIT_SIZE_CENTS=10000
EDGE_MIN_STAKE_CENTS=10000
EDGE_MAX_STAKE_CENTS=100000
EDGE_DAILY_LOSS_LIMIT_CENTS=50000
EDGE_WEEKLY_LOSS_LIMIT_CENTS=100000
EDGE_MY_BOOKS=hardrockbet,draftkings
EDGE_PRICING_BOOK=hardrockbet
EDGE_MIN_WIN_PROBABILITY=0.55
ODDS_API_PROPS_ENABLED=true
ODDS_API_PROPS_HORIZON_HOURS=36
ODDS_API_PROPS_MAX_EVENTS=40
ODDS_API_BACKFILL_MAX_SHARE_PCT=25
